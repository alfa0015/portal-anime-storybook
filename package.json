{
  "name": "storybook-pa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "storybook": "NODE_OPTIONS=--no-deprecation storybook dev -p 6006 --host 0.0.0.0",
    "build-storybook": "NODE_OPTIONS=--no-deprecation storybook build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,vue}": [
      "eslint --fix",
      "oxlint --fix"
    ],
    "*.{js,jsx,mjs,vue,css,scss,md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.4",
    "@storybook/addon-docs": "^10.5.4",
    "@storybook/addon-onboarding": "^10.5.4",
    "@storybook/addon-vitest": "^10.5.4",
    "@storybook/vue3-vite": "^10.5.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-playwright": "^2.10.5",
    "eslint-plugin-storybook": "^10.5.4",
    "eslint-plugin-vue": "~10.9.2",
    "globals": "^17.7.0",
    "husky": "9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "17.2.0",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.74.0",
    "playwright": "^1.62.0",
    "prettier": "3.9.5",
    "storybook": "^10.5.4",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "pnpm@11.9.0"
}
